<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#0B1220">
  <link rel="canonical" href="{{ canonical_url }}">
  {%- if settings.isotipo -%}
    <link rel="icon" type="image/png" href="{{ settings.isotipo | image_url: width: 64 }}">
  {%- else -%}
    <link rel="icon" type="image/png" href="{{ 'isotipo.png' | asset_url }}">
  {%- endif -%}
  <title>{{ page_title }}{% if current_page != 1 %} · Página {{ current_page }}{% endif %}{% unless page_title contains shop.name %} | {{ shop.name }}{% endunless %}</title>
  {%- if page_description -%}<meta name="description" content="{{ page_description | escape }}">{%- endif -%}
  {%- render 'meta-tags' -%}

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&family=Unbounded:wght@600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://unpkg.com/@phosphor-icons/web@2.1.1/src/regular/style.css">
  <link rel="stylesheet" href="https://unpkg.com/@phosphor-icons/web@2.1.1/src/fill/style.css">
  {{ 'base.css' | asset_url | stylesheet_tag }}
  {{ 'shopify.css' | asset_url | stylesheet_tag }}

  <script>
    window.AS = {
      moneyFormat: {{ shop.money_format | json }},
      routes: { cart: {{ routes.cart_url | json }}, cartAdd: {{ routes.cart_add_url | json }}, search: {{ routes.predictive_search_url | json }} },
      whatsapp: {{ settings.whatsapp | remove: '+' | remove: ' ' | json }}
    };
  </script>
  <script src="{{ 'theme.js' | asset_url }}" defer></script>
  {{ content_for_header }}
</head>
<body class="t-{{ template.name }}{% if template.suffix %} t-{{ template.name }}-{{ template.suffix }}{% endif %}{% if request.design_mode %} shopify-design-mode{% endif %}">
  <a class="skip" href="#main">Saltar al contenido</a>
  {% sections 'header-group' %}

  <main id="main" tabindex="-1">
    {{ content_for_layout }}
  </main>

  {% sections 'footer-group' %}

  {%- capture wa -%}{%- render 'wa-url', text: settings.whatsapp_msg -%}{%- endcapture -%}
  <a class="wa-float" href="{{ wa | strip }}" target="_blank" rel="noopener" aria-label="Escríbenos por WhatsApp"><i class="ph ph-whatsapp-logo"></i><span>¿Dudas? Escríbenos</span></a>
  <div class="toast" id="toast" role="status" aria-live="polite"></div>
</body>
</html>
