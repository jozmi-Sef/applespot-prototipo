{%- assign s = section.settings -%}
<section class="sec" aria-labelledby="acc-{{ section.id }}">
  <div class="wrap">
    <div class="sec-head rv"><p class="kicker">{{ s.kicker }}</p><h2 id="acc-{{ section.id }}">{{ s.heading }}</h2>{%- if s.text != blank -%}<p>{{ s.text }}</p>{%- endif -%}</div>
    <div class="acc-row">
      <div class="combo rv">
        <h3>{{ s.combos_title }}</h3>
        <ul class="combo-list">
          {%- for block in section.blocks -%}
            {%- assign p = block.settings.product -%}
            {%- if p != blank -%}
              {%- assign v = p.selected_or_first_available_variant -%}
              <li {{ block.shopify_attributes }}>
                <span class="l"><i class="ph ph-{{ block.settings.icon }}"></i><span><a href="{{ p.url }}">{{ p.title }}</a><small>{{ block.settings.detail }}</small></span></span>
                <span class="r"><span><b>{{ v.price | money_without_trailing_zeros }}</b>{%- if v.compare_at_price > v.price -%}<s>{{ v.compare_at_price | money_without_trailing_zeros }}</s>{%- endif -%}</span>
                  {%- if p.available -%}<button type="button" class="add-mini" data-add-variant="{{ v.id }}" data-title="{{ p.title | escape }}" aria-label="Agregar {{ p.title | escape }} al carrito"><i class="ph ph-plus"></i></button>{%- endif -%}
                </span>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
        {%- if s.button_label != blank -%}<a href="{{ s.button_link }}" class="btn btn-dark" style="margin-top:24px">{{ s.button_label }} <i class="ph ph-arrow-right"></i></a>{%- endif -%}
      </div>

      {%- form 'customer', class: 'signup rv', id: 'signup-form' -%}
        <div><div class="pct">{{ s.pct }}</div><h3>{{ s.signup_title }}</h3><p>{{ s.signup_text }}</p></div>
        <input type="hidden" name="contact[tags]" value="newsletter,primera-compra">
        {%- if form.posted_successfully? -%}
          <p class="msg ok" role="status">Listo. Tu código es <b>{{ settings.coupon_code }}</b>. Úsalo al pagar tus accesorios.</p>
        {%- else -%}
          <div class="field">
            <label for="nl-{{ section.id }}">Correo electrónico</label>
            <div class="input-row"><input id="nl-{{ section.id }}" type="email" name="contact[email]" placeholder="tu@correo.com" autocomplete="email" required><button class="btn btn-primary btn-sm" type="submit" style="padding:8px 16px">Quiero mi código</button></div>
            {%- if form.errors -%}<p class="msg e">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>{%- endif -%}
            <label class="check" style="color:#9B9B9B;font-weight:500"><input type="checkbox" required><span>Acepto recibir promociones según la <a href="{{ routes.root_url }}pages/politica-de-privacidad" target="_blank" rel="noopener" style="color:#fff;text-decoration:underline;text-underline-offset:2px">política de privacidad</a>.</span></label>
          </div>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Combos + cupón",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Antetítulo", "default": "Accesorios" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Completa tu iPhone" },
    { "type": "textarea", "id": "text", "label": "Texto", "default": "Originales o certificados. Arma tu combo y paga menos." },
    { "type": "text", "id": "combos_title", "label": "Título de combos", "default": "Combos recomendados" },
    { "type": "text", "id": "button_label", "label": "Botón", "default": "Ver todos los accesorios" },
    { "type": "url", "id": "button_link", "label": "Enlace del botón" },
    { "type": "header", "content": "Cupón por suscripción" },
    { "type": "text", "id": "pct", "label": "Número grande", "default": "10%" },
    { "type": "text", "id": "signup_title", "label": "Título", "default": "de descuento en tu primera compra de accesorios" },
    { "type": "textarea", "id": "signup_text", "label": "Texto", "default": "Déjanos tu correo y te mostramos tu código al instante." }
  ],
  "max_blocks": 6,
  "blocks": [
    {
      "type": "combo", "name": "Combo",
      "settings": [
        { "type": "product", "id": "product", "label": "Producto del combo", "info": "Crea cada combo como un producto propio con su precio especial." },
        { "type": "text", "id": "detail", "label": "Qué incluye", "default": "Cubo 20W + cable USB C" },
        { "type": "text", "id": "icon", "label": "Ícono (Phosphor)", "default": "plug" }
      ]
    }
  ],
  "presets": [{ "name": "Combos + cupón" }]
}
{% endschema %}
