{%- assign s = section.settings -%}
{%- assign p = s.product -%}
{%- assign color_index = -1 -%}
{%- for o in p.options_with_values -%}{%- assign on = o.name | downcase -%}{%- if on contains 'color' -%}{%- assign color_index = forloop.index0 -%}{%- endif -%}{%- endfor -%}
{%- assign first_color = s.color -%}
{%- if color_index >= 0 -%}{%- assign first_color = p.options_with_values[color_index].values.first -%}{%- endif -%}
<section class="spin" aria-label="{{ s.kicker }}: {{ s.heading | escape }}" data-spin>
  <div class="spin-sticky">
    <div class="spin-glow" aria-hidden="true"></div>
    <div class="spin-intro"><p class="kicker">{{ s.kicker }}</p><h2 style="margin-top:12px">{{ s.heading }}</h2><p>{{ s.hint }}</p></div>
    {%- assign vid = s.video_url -%}
    {%- if vid == blank and s.use_3d_video -%}{%- assign vid = 'iphone-giro-cosmic.mp4' | asset_url -%}{%- endif -%}
    {%- if vid != blank -%}
      <video class="spin-video" src="{{ vid }}" poster="{{ 'iphone-giro-poster.jpg' | asset_url }}" muted playsinline preload="auto" aria-hidden="true"></video>
    {%- else -%}
      <div class="spin-scene" aria-hidden="true">
        <div class="phone3d">
          <div class="face front">{%- render 'phone-svg', color: first_color, side: 'front', cls: '', cams: 3, key: section.id -%}</div>
          <div class="side l"></div><div class="side r"></div>
          <div class="face back">{%- render 'phone-svg', color: first_color, side: 'back', cls: '', cams: 3, key: section.id -%}</div>
        </div>
      </div>
    {%- endif -%}
    <div class="spin-copy">
      {%- for block in section.blocks limit: 4 -%}
        <div class="callout c{{ forloop.index }}" {{ block.shopify_attributes }}><span class="kicker">{{ block.settings.kicker }}</span><h3>{{ block.settings.title }}</h3><p>{{ block.settings.text }}</p></div>
      {%- endfor -%}
    </div>
    <div class="spin-end">
      {%- if color_index >= 0 -%}
        {%- assign copt = p.options_with_values[color_index] -%}
        <div class="swatches" role="group" aria-label="Elige un color">
          {%- for val in copt.values -%}
            {%- capture f -%}{%- render 'finish', name: val -%}{%- endcapture -%}{%- assign fp = f | strip | split: '|' -%}
            {%- assign cv = nil -%}{%- for var in p.variants -%}{%- if cv == nil and var.options[color_index] == val -%}{%- assign cv = var -%}{%- endif -%}{%- endfor -%}
            <button type="button" class="sw" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}" aria-label="{{ val | escape }}" style="background:{% if val.swatch.color %}{{ val.swatch.color }}{% else %}{{ fp[2] }}{% endif %}" data-pa="{{ fp[0] }}" data-pb="{{ fp[1] }}" data-href="{{ cv.url }}"></button>
          {%- endfor -%}
        </div>
        <small>{{ first_color }}</small>
      {%- endif -%}
      <a href="{{ p.url | default: routes.all_products_collection_url }}" class="btn btn-primary" data-spin-cta>{{ s.cta }} <i class="ph ph-arrow-right"></i></a>
    </div>
    <div class="spin-bar" aria-hidden="true"><i></i></div>
  </div>
</section>

{% schema %}
{
  "name": "Novedades (giro 3D)",
  "settings": [
    { "type": "product", "id": "product", "label": "Producto", "info": "Se usan sus colores y su enlace." },
    { "type": "text", "id": "kicker", "label": "Antetítulo", "default": "Novedades" },
    { "type": "text", "id": "heading", "label": "Título", "default": "iPhone 18 Pro Max" },
    { "type": "text", "id": "hint", "label": "Indicación", "default": "Desliza para descubrirlo" },
    { "type": "text", "id": "color", "label": "Color inicial del dibujo", "default": "Naranja cósmico" },
    { "type": "checkbox", "id": "use_3d_video", "label": "Usar el iPhone 3D renderizado (naranja cósmico)", "default": true, "info": "Video incluido en el tema. Desactívalo para volver al iPhone dibujado." },
    { "type": "url", "id": "video_url", "label": "Otro video del giro (opcional)", "info": "Sube un MP4 en Contenido > Archivos y pega su enlace. Reemplaza al video 3D incluido." },
    { "type": "text", "id": "cta", "label": "Botón", "default": "Compra ahora" }
  ],
  "max_blocks": 4,
  "blocks": [
    {
      "type": "callout",
      "name": "Característica",
      "settings": [
        { "type": "text", "id": "kicker", "label": "Antetítulo", "default": "Cámara" },
        { "type": "text", "id": "title", "label": "Título", "default": "Tres cámaras para fotos que se notan" },
        { "type": "textarea", "id": "text", "label": "Texto" }
      ]
    }
  ],
  "presets": [{ "name": "Novedades (giro 3D)", "blocks": [{ "type": "callout" }] }]
}
{% endschema %}
