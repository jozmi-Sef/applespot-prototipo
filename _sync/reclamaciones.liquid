{%- comment -%}
  Libro de Reclamaciones virtual. Envía la hoja al correo de la tienda (formulario de contacto de Shopify).
  IMPORTANTE: la norma exige entregar una copia al consumidor. Shopify no la envía automáticamente;
  la tienda debe responder con la copia o usar una app especializada.
{%- endcomment -%}
<section class="sec" style="padding-top:48px">
  <div class="wrap" style="max-width:880px">
    <p style="color:var(--ink-2);margin-bottom:24px">Conforme al Código de Protección y Defensa del Consumidor. Proveedor: {{ shop.name }}{% if settings.ruc != blank %} · RUC {{ settings.ruc }}{% endif %} · {{ settings.address }}.</p>
    {%- form 'contact', class: 'form', id: 'reclamo-form' -%}
      {%- if form.posted_successfully? -%}
        <div class="panel done"><div class="ico"><i class="ph ph-check"></i></div><h2>Registramos tu hoja de reclamación</h2><p>Te enviaremos una copia y la respuesta al correo que indicaste, en un plazo máximo de 15 días hábiles.</p><div class="ctas"><a class="btn btn-line" href="{{ routes.root_url }}">Volver al inicio</a></div></div>
      {%- else -%}
        {%- if form.errors -%}<div class="warn"><i class="ph-fill ph-warning"></i><div>{{ form.errors | default_errors }}</div></div>{%- endif -%}
        <input type="hidden" name="contact[Formulario]" value="Libro de Reclamaciones">
        <input type="hidden" name="contact[Fecha]" value="{{ 'now' | date: '%d/%m/%Y %H:%M' }}">
        <div class="panel"><div class="panel-step"><span class="n">1</span><h2>Datos del consumidor</h2></div><div class="form">
          <div class="two">
            <div class="field"><label for="r-name">Nombres y apellidos</label><input class="inp" id="r-name" name="contact[name]" required autocomplete="name"></div>
            <div class="field"><label for="r-doc">DNI o carné de extranjería</label><input class="inp" id="r-doc" name="contact[Documento]" required minlength="8" maxlength="12"></div>
          </div>
          <div class="field"><label for="r-dir">Domicilio</label><input class="inp" id="r-dir" name="contact[Domicilio]" required autocomplete="street-address"></div>
          <div class="two">
            <div class="field"><label for="r-tel">Teléfono</label><input class="inp" id="r-tel" type="tel" name="contact[phone]" required pattern="9[0-9]{8}" inputmode="numeric" title="9 dígitos, empezando con 9"></div>
            <div class="field"><label for="r-mail">Correo</label><input class="inp" id="r-mail" type="email" name="contact[email]" required autocomplete="email"></div>
          </div>
          <label class="check"><input type="checkbox" id="r-menor" name="contact[Menor de edad]" value="Sí"><span>Soy menor de edad (lo completa mi padre, madre o apoderado)</span></label>
          <div class="field hidden" id="r-apo-wrap"><label for="r-apo">Nombre del padre, madre o apoderado</label><input class="inp" id="r-apo" name="contact[Apoderado]"></div>
          <script>
            (function () {
              var c = document.getElementById('r-menor'), w = document.getElementById('r-apo-wrap'), i = document.getElementById('r-apo');
              c.addEventListener('change', function () { w.classList.toggle('hidden', !c.checked); i.required = c.checked; if (c.checked) i.focus(); });
            })();
          </script>
        </div></div>
        <div class="panel"><div class="panel-step"><span class="n">2</span><h2>Bien contratado</h2></div><div class="form">
          <div class="choice cols2">
            <label class="ch"><input type="radio" name="contact[Bien]" value="Producto" checked><i class="ph ph-device-mobile"></i><span><b>Producto</b></span><span class="tick"><i class="ph ph-check"></i></span></label>
            <label class="ch"><input type="radio" name="contact[Bien]" value="Servicio"><i class="ph ph-wrench"></i><span><b>Servicio</b></span><span class="tick"><i class="ph ph-check"></i></span></label>
          </div>
          <div class="two">
            <div class="field"><label for="r-monto">Monto reclamado (S/) <span class="opt-tag">(opcional)</span></label><input class="inp" id="r-monto" name="contact[Monto]" inputmode="decimal"></div>
            <div class="field"><label for="r-ped">N.° de pedido o boleta <span class="opt-tag">(opcional)</span></label><input class="inp" id="r-ped" name="contact[Pedido]"></div>
          </div>
          <div class="field"><label for="r-desc">Descripción del producto o servicio</label><textarea class="inp" id="r-desc" name="contact[Descripcion]" required></textarea></div>
        </div></div>
        <div class="panel"><div class="panel-step"><span class="n">3</span><h2>Detalle</h2></div><div class="form">
          <div class="choice cols2">
            <label class="ch"><input type="radio" name="contact[Tipo]" value="Reclamo" checked><i class="ph ph-warning-circle"></i><span><b>Reclamo</b><small>Disconformidad con el producto o servicio</small></span><span class="tick"><i class="ph ph-check"></i></span></label>
            <label class="ch"><input type="radio" name="contact[Tipo]" value="Queja"><i class="ph ph-chat-circle-text"></i><span><b>Queja</b><small>Malestar con la atención recibida</small></span><span class="tick"><i class="ph ph-check"></i></span></label>
          </div>
          <div class="field"><label for="r-det">Detalle del reclamo o queja</label><textarea class="inp" id="r-det" name="contact[body]" required></textarea></div>
          <div class="field"><label for="r-pedido">Pedido del consumidor</label><textarea class="inp" id="r-pedido" name="contact[Pedido del consumidor]" placeholder="¿Qué solución esperas?" required></textarea></div>
          <label class="check"><input type="checkbox" required><span>Declaro que la información es verdadera. La formulación del reclamo no impide acudir a otras vías de solución de controversias ni es requisito previo para interponer una denuncia ante INDECOPI.</span></label>
          <button class="btn btn-primary" type="submit" style="justify-self:start">Enviar reclamo</button>
          <p class="note" style="justify-content:flex-start;margin:0"><i class="ph ph-info"></i>Responderemos en un plazo máximo de 15 días hábiles al correo indicado.</p>
        </div></div>
      {%- endif -%}
    {%- endform -%}
  </div>
</section>

{% schema %}
{ "name": "Libro de Reclamaciones", "presets": [{ "name": "Libro de Reclamaciones" }] }
{% endschema %}
