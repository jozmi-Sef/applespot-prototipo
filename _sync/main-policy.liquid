{%- comment -%} Páginas legales con el diseño del prototipo: menú lateral + documento. {%- endcomment -%}
<section class="sec" style="padding-top:128px">
  <div class="wrap">
    <nav class="crumbs light" aria-label="Ruta"><a href="{{ routes.root_url }}">Inicio</a><span>/</span><span aria-current="page">Políticas</span></nav>
    <h1 style="font-size:48px;line-height:1;letter-spacing:-.025em;margin-bottom:40px">{{ section.settings.heading }}</h1>
    <div class="legal-grid">
      <nav class="legal-nav" aria-label="Políticas">
        {%- for link in section.settings.menu.links -%}
          <a href="{{ link.url }}"{% if link.url == page.url %} aria-current="true"{% endif %}>{{ link.title }}</a>
        {%- endfor -%}
      </nav>
      <div class="doc">
        <article>
          <h2>{{ page.title }}</h2>
          <p class="upd">Última actualización: {{ page.updated_at | date: '%d/%m/%Y' }}</p>
          <div class="rte">{{ page.content }}</div>
        </article>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Política de la tienda",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Políticas de la tienda" },
    { "type": "link_list", "id": "menu", "label": "Menú lateral", "default": "main-menu", "info": "Elige el menú «Políticas»." }
  ]
}
{% endschema %}
